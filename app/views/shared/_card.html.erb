<% image = list.movies.first&.poster_url || "https://raw.githubusercontent.com/lewagon/fullstack-images/master/uikit/breakfast.jpg" %>

<%= link_to list_path(list),
      class: "card-category",
      style: "background-image: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url('#{image}')" do %>
  <%= list.name %>
<% end %>
