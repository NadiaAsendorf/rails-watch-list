<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
      <div class="card shadow-sm border-0">
        <div class="card-body p-4">
          <h1 class="h3 mb-4">Create a new list</h1>

          <%= simple_form_for(@list) do |f| %>
            <%= f.error_notification %>
            <%= f.input :name,
                        label: "List name",
                        placeholder: "e.g. Classic movies",
                        input_html: { autofocus: true } %>
            <%= f.input :image_url,
                        label: "Image URL",
                        placeholder: "https://...",
                        hint: "Optional. Shown as the background of the list card." %>
            <%= f.input :photo, as: :file %>

            <div class="d-flex justify-content-between align-items-center mt-4">
              <%= link_to "Cancel", lists_path, class: "btn btn-link text-secondary" %>
              <%= f.button :submit, "Create list", class: "btn-success" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
