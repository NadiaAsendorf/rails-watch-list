<% header_image = @list.image_url.presence || @list.movies.first&.poster_url %>

<div class="list-header"
     style="background-image: linear-gradient(rgba(0,0,0,0.55), rgba(0,0,0,0.55)), url('<%= header_image %>')">
  <h1><%= @list.name %></h1>
  <p><%= pluralize(@list.bookmarks.size, "movie") %></p>
</div>

<div class="container my-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <%= link_to "← All lists", lists_path, class: "text-secondary text-decoration-none" %>
    <%= link_to "Add a movie", new_list_bookmark_path(@list), class: "btn btn-success" %>
  </div>

  <% if @list.bookmarks.empty? %>
    <p class="text-muted text-center my-5">No movies in this list yet. Add the first one!</p>
  <% else %>
    <div class="row g-4">
      <% @list.bookmarks.each do |bookmark| %>
        <div class="col-6 col-md-4 col-lg-3">
          <div class="card movie-card h-100 border-0 shadow-sm">
            <%= image_tag bookmark.movie.poster_url, class: "card-img-top", alt: bookmark.movie.title %>
            <div class="card-body d-flex flex-column">
              <h5 class="card-title"><%= bookmark.movie.title %></h5>
              <p class="card-text text-muted fst-italic">“<%= bookmark.comment %>”</p>
              <div class="mt-auto">
                <%= button_to "Remove", bookmark_path(bookmark),
                      method: :delete,
                      class: "btn btn-sm btn-outline-danger w-100",
                      form: { data: { turbo_confirm: "Remove #{bookmark.movie.title} from this list?" } } %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
