<%= render "shared/banner" %>

<div class="container my-5">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2>My Lists</h2>
    <%= link_to "Create a movie list", new_list_path, class: "btn btn-success" %>
  </div>

  <div class="cards">
    <% @lists.each do |list| %>
      <%= render "shared/card", list: list %>
    <% end %>
  </div>
</div>
